<?xml version="1.0" encoding="utf-8"?>
<!-- Le API usate dall'app sono tutte in https. Il traffico in chiaro resta permesso solo
     perché molte radio trasmettono lo streaming audio in http. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
